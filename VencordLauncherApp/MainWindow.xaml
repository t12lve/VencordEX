<Window x:Class="VencordLauncher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:VencordLauncher"
        mc:Ignorable="d"
        Title="Discord • VencordEX" 
        Height="310" Width="540"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Icon="app.ico"
        ShowInTaskbar="True"
        MouseLeftButtonDown="Window_MouseLeftButtonDown"
        Loaded="Window_Loaded">

    <Window.Resources>
        <!-- Animation subtile de respiration pour le point d'état vert -->
        <Storyboard x:Key="PulseStoryboard" RepeatBehavior="Forever">
            <DoubleAnimation Storyboard.TargetName="PulseDot"
                             Storyboard.TargetProperty="Opacity"
                             From="1.0" To="0.4" Duration="0:0:1.2"
                             AutoReverse="True" />
            <DoubleAnimation Storyboard.TargetName="PulseDotScale"
                             Storyboard.TargetProperty="ScaleX"
                             From="1.0" To="1.25" Duration="0:0:1.2"
                             AutoReverse="True" />
            <DoubleAnimation Storyboard.TargetName="PulseDotScale"
                             Storyboard.TargetProperty="ScaleY"
                             From="1.0" To="1.25" Duration="0:0:1.2"
                             AutoReverse="True" />
        </Storyboard>
    </Window.Resources>

    <Grid Margin="12">
        <!-- Fenêtre principale (Shape Consistency : 16px) -->
        <Border x:Name="MainContainerBorder" CornerRadius="16" Background="#0c0e16" BorderBrush="#1f2436" BorderThickness="1.2">
            <Border.Effect>
                <DropShadowEffect BlurRadius="28" ShadowDepth="0" Color="#5865F2" Opacity="0.3"/>
            </Border.Effect>

            <Grid Margin="24,20,24,20">

                <!-- ═══════════════════════════════════════════════════════ -->
                <!-- ÉCRAN 1 : PRÉCHARGEUR FLUIDE                            -->
                <!-- ═══════════════════════════════════════════════════════ -->
                <Grid x:Name="PreloaderGrid" Visibility="Visible">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- En-tête : Badge VencordEX + Bouton Paramètres ⚙️ -->
                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Image Source="app.ico" Width="18" Height="18" Margin="0,0,8,0"/>
                            <TextBlock Text="VENCORDEX" FontWeight="Black" FontSize="13" Foreground="#8da0f9"/>
                            <TextBlock Text=" • AUTO-PATCHER" FontWeight="Bold" FontSize="13" Foreground="#4c536b" Margin="4,0,0,0"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <!-- Indicateur statut pill (20px) -->
                            <Border Background="#121622" CornerRadius="12" Padding="9,3,11,3" BorderBrush="#22283a" BorderThickness="1" Margin="0,0,8,0">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Grid Width="7" Height="7" Margin="0,0,7,0">
                                        <Ellipse x:Name="PulseDot" Fill="#10B981" RenderTransformOrigin="0.5,0.5">
                                            <Ellipse.RenderTransform>
                                                <ScaleTransform x:Name="PulseDotScale" ScaleX="1" ScaleY="1"/>
                                            </Ellipse.RenderTransform>
                                        </Ellipse>
                                    </Grid>
                                    <TextBlock x:Name="BadgeText" Text="INJECTION" FontSize="10.5" FontWeight="Bold" Foreground="#10B981"/>
                                </StackPanel>
                            </Border>

                            <!-- Bouton accès au Centre de Contrôle (8px) -->
                            <Button Click="BtnOpenManager_Click" ToolTip="Ouvrir le Centre de Contrôle"
                                    Width="26" Height="26" Background="#141824" BorderBrush="#22283a" BorderThickness="1" Cursor="Hand">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="7">
                                            <TextBlock Text="⚙" FontSize="12" Foreground="#8da0f9" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </StackPanel>
                    </Grid>

                    <!-- Section Centrale : Compteur Haute Précision -->
                    <Grid Grid.Row="1" VerticalAlignment="Center" Margin="0,12,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock x:Name="StatusTitle" Text="SYNCHRONISATION" FontSize="10.5" FontWeight="Bold" Foreground="#5e6682" Margin="0,0,0,3"/>
                            <TextBlock x:Name="StatusSub" Text="Vérification des fichiers de Discord..." FontSize="13.5" FontWeight="SemiBold" Foreground="#f3f4f6" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>

                        <!-- Compteur avec tabular figures -->
                        <TextBlock x:Name="PercentText" Grid.Column="1" Text="00%" 
                                   FontSize="50" FontWeight="Black" 
                                   FontFamily="Segoe UI Variable Display, Outfit, Inter, Segoe UI" 
                                   Foreground="#FFFFFF" 
                                   VerticalAlignment="Center" HorizontalAlignment="Right">
                            <TextBlock.Effect>
                                <DropShadowEffect BlurRadius="18" ShadowDepth="0" Color="#5865F2" Opacity="0.35"/>
                            </TextBlock.Effect>
                        </TextBlock>
                    </Grid>

                    <!-- Barre de progression fluide -->
                    <Grid Grid.Row="2" Margin="0,4,0,10">
                        <Border Height="10" Background="#131622" CornerRadius="5" BorderBrush="#1c2132" BorderThickness="1">
                            <Grid ClipToBounds="True">
                                <Border x:Name="ProgressBarFill" HorizontalAlignment="Left" Width="0" CornerRadius="4">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                            <GradientStop Color="#5865F2" Offset="0.0"/>
                                            <GradientStop Color="#707DF7" Offset="0.5"/>
                                            <GradientStop Color="#10B981" Offset="1.0"/>
                                        </LinearGradientBrush>
                                    </Border.Background>
                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="10" ShadowDepth="0" Color="#5865F2" Opacity="0.6"/>
                                    </Border.Effect>
                                </Border>
                            </Grid>
                        </Border>
                    </Grid>

                    <!-- Pied de carte avec signature -->
                    <Grid Grid.Row="3">
                        <TextBlock x:Name="FooterText" Text="PRÉPARATION DE DISCORD EN COURS..." 
                                   FontSize="10" FontWeight="Bold" Foreground="#4e5670" 
                                   HorizontalAlignment="Left" VerticalAlignment="Center"/>
                        <TextBlock Text="t12lve le vibecodeur de l'extreme" 
                                   FontSize="10" FontWeight="SemiBold" Foreground="#8da0f9" 
                                   HorizontalAlignment="Right" VerticalAlignment="Center"/>
                    </Grid>
                </Grid>

                <!-- ═══════════════════════════════════════════════════════ -->
                <!-- ÉCRAN 2 : MODALE INTELLIGENTE (DISCORD DÉJÀ OUVERT)    -->
                <!-- ═══════════════════════════════════════════════════════ -->
                <Grid x:Name="ConfirmGrid" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Image Source="app.ico" Width="18" Height="18" Margin="0,0,8,0"/>
                            <TextBlock Text="VENCORDEX" FontWeight="Black" FontSize="13" Foreground="#8da0f9"/>
                            <TextBlock Text=" • SESSION EN COURS" FontWeight="Bold" FontSize="13" Foreground="#4c536b" Margin="4,0,0,0"/>
                        </StackPanel>
                    </Grid>

                    <StackPanel Grid.Row="1" VerticalAlignment="Center" Margin="0,8,0,10">
                        <TextBlock Text="Discord est actuellement ouvert" 
                                   FontSize="17" FontWeight="Bold" Foreground="#FFFFFF" Margin="0,0,0,5"/>
                        <TextBlock Text="Une mise à jour Discord a été détectée. Voulez-vous relancer Discord maintenant pour appliquer Vencord, ou différer le patch au prochain démarrage sans couper votre appel ?" 
                                   FontSize="12.5" Foreground="#9ca3af" TextWrapping="Wrap" LineHeight="18"/>
                    </StackPanel>

                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Button x:Name="BtnKillAndPatch" Grid.Column="0" Click="BtnKillAndRestart_Click"
                                Height="42" Cursor="Hand" Background="#5865F2">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="8">
                                        <TextBlock Text="⚡ Oui, redémarrer" FontWeight="Bold" FontSize="12.5" Foreground="#FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="border" Property="Background" Value="#4752C4"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>

                        <Button x:Name="BtnPatchNextLaunch" Grid.Column="2" Click="BtnPatchNextLaunch_Click"
                                Height="42" Cursor="Hand" Background="#161926">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="border" Background="{TemplateBinding Background}" BorderBrush="#252b3d" BorderThickness="1.2" CornerRadius="8">
                                        <TextBlock Text="⏱ Au prochain lancement" FontWeight="SemiBold" FontSize="12" Foreground="#d1d5db" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="border" Property="Background" Value="#1d2233"/>
                                            <Setter TargetName="border" Property="BorderBrush" Value="#3a4360"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </Grid>
                </Grid>

                <!-- ═══════════════════════════════════════════════════════ -->
                <!-- ÉCRAN 3 : CENTRE DE CONTRÔLE VENCORDEX (GUI COMPLET)  -->
                <!-- ═══════════════════════════════════════════════════════ -->
                <Grid x:Name="ManagerGrid" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- 1. En-tête -->
                    <Grid Grid.Row="0" Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Image Source="app.ico" Width="18" Height="18" Margin="0,0,8,0"/>
                            <TextBlock Text="VENCORDEX" FontWeight="Black" FontSize="13" Foreground="#8da0f9"/>
                            <TextBlock Text=" • CENTRE DE CONTRÔLE" FontWeight="Bold" FontSize="13" Foreground="#4c536b" Margin="4,0,0,0"/>
                            <Border Background="#1c2234" CornerRadius="4" Padding="6,2" Margin="8,0,0,0">
                                <TextBlock Text="v1.1.1" FontSize="10.5" FontWeight="Bold" Foreground="#8da0f9"/>
                            </Border>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button x:Name="BtnUpdateAction" Click="BtnUpdateAction_Click" Height="26" Background="#161a26" BorderBrush="#22283a" BorderThickness="1" Padding="8,0" Margin="0,0,8,0" Cursor="Hand">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="BtnBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock x:Name="TxtUpdateIcon" Text="🔄" FontSize="10" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                                <TextBlock x:Name="TxtUpdateStatus" Text="Vérifier MàJ" FontSize="10.5" FontWeight="SemiBold" Foreground="#d1d5db" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Border>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>

                            <Button Click="BtnCloseManager_Click" Width="26" Height="26" Background="#141824" BorderBrush="#22283a" BorderThickness="1" Cursor="Hand">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6">
                                            <TextBlock Text="✕" FontSize="11" Foreground="#9ca3af" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </StackPanel>
                    </Grid>

                    <!-- 2. Métriques de Statut en Direct (Bento 5 blocs) -->
                    <Border Grid.Row="1" Background="#111420" CornerRadius="10" Padding="12,8" BorderBrush="#1c2234" BorderThickness="1" Margin="0,0,0,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="DISCORD" FontSize="9" FontWeight="Bold" Foreground="#5e6682"/>
                                <TextBlock x:Name="LblDiscordVersion" Text="1.0.9255" FontSize="11.5" FontWeight="Bold" Foreground="#FFFFFF" Margin="0,2,0,0"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1">
                                <TextBlock Text="VENCORD" FontSize="9" FontWeight="Bold" Foreground="#5e6682"/>
                                <TextBlock x:Name="LblVencordStatus" Text="✓ ACTIF" FontSize="11.5" FontWeight="Bold" Foreground="#10B981" Margin="0,2,0,0"/>
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="OPENASAR" FontSize="9" FontWeight="Bold" Foreground="#5e6682"/>
                                <TextBlock x:Name="LblOpenAsarStatus" Text="NON INSTALLÉ" FontSize="11.5" FontWeight="Bold" Foreground="#9ca3af" Margin="0,2,0,0"/>
                            </StackPanel>

                            <StackPanel Grid.Column="3">
                                <TextBlock Text="RACCOURCI" FontSize="9" FontWeight="Bold" Foreground="#5e6682"/>
                                <TextBlock x:Name="LblShortcutStatus" Text="✓ PROTÉGÉ" FontSize="11.5" FontWeight="Bold" Foreground="#10B981" Margin="0,2,0,0"/>
                            </StackPanel>

                            <StackPanel Grid.Column="4">
                                <TextBlock Text="VERSION EX" FontSize="9" FontWeight="Bold" Foreground="#5e6682"/>
                                <TextBlock x:Name="LblVencordEXVersion" Text="v1.1.1" FontSize="11.5" FontWeight="Bold" Foreground="#8da0f9" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- 3. Cartes d'Actions Épurées -->
                    <Grid Grid.Row="2" Margin="0,0,0,10">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="8"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- CARTE 1 : RACCOURCIS WINDOWS -->
                        <Border Grid.Row="0" Grid.Column="0" Background="#111420" CornerRadius="10" Padding="12" BorderBrush="#1c2234" BorderThickness="1">
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="🔗 RACCOURCIS DISCORD" FontSize="10" FontWeight="Bold" Foreground="#8da0f9" Margin="0,0,0,6"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="6"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Button Click="BtnPatchShortcut_Click" Grid.Column="0" Height="32" Background="#5865F2" Cursor="Hand">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}" CornerRadius="6">
                                                    <TextBlock Text="Patcher (Auto)" FontSize="10.5" FontWeight="Bold" Foreground="#fff" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                    <Button Click="BtnUnpatchShortcut_Click" Grid.Column="2" Height="32" Background="#161a26" Cursor="Hand">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}" BorderBrush="#22283a" BorderThickness="1" CornerRadius="6">
                                                    <TextBlock Text="Restaurer original" FontSize="10.5" FontWeight="SemiBold" Foreground="#d1d5db" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- CARTE 2 : OPENASAR & PERFORMANCE -->
                        <Border Grid.Row="0" Grid.Column="2" Background="#111420" CornerRadius="10" Padding="12" BorderBrush="#1c2234" BorderThickness="1">
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="⚡ OPENASAR (PERFORMANCE)" FontSize="10" FontWeight="Bold" Foreground="#8da0f9" Margin="0,0,0,6"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="6"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Button Click="BtnInstallOpenAsar_Click" Grid.Column="0" Height="32" Background="#1c2234" Cursor="Hand">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}" BorderBrush="#2d354e" BorderThickness="1" CornerRadius="6">
                                                    <TextBlock Text="Installer OpenAsar" FontSize="10.5" FontWeight="Bold" Foreground="#8da0f9" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                    <Button Click="BtnUninstallOpenAsar_Click" Grid.Column="2" Height="32" Background="#161a26" Cursor="Hand">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}" BorderBrush="#22283a" BorderThickness="1" CornerRadius="6">
                                                    <TextBlock Text="Retirer" FontSize="10.5" FontWeight="SemiBold" Foreground="#d1d5db" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- CARTE 3 : PRÉFÉRENCES & THÈMES (ZIP) -->
                        <Border Grid.Row="2" Grid.Column="0" Background="#111420" CornerRadius="10" Padding="12" BorderBrush="#1c2234" BorderThickness="1">
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="💾 SAUVEGARDE PRÉFÉRENCES (ZIP)" FontSize="10" FontWeight="Bold" Foreground="#10B981" Margin="0,0,0,6"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="6"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Button Click="BtnBackupPreferences_Click" Grid.Column="0" Height="32" Background="#142b20" Cursor="Hand">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}" BorderBrush="#1e4432" BorderThickness="1" CornerRadius="6">
                                                    <TextBlock Text="Sauvegarder" FontSize="10.5" FontWeight="Bold" Foreground="#10B981" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                    <Button Click="BtnRestorePreferences_Click" Grid.Column="2" Height="32" Background="#161a26" Cursor="Hand">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}" BorderBrush="#22283a" BorderThickness="1" CornerRadius="6">
                                                    <TextBlock Text="Importer ZIP" FontSize="10.5" FontWeight="SemiBold" Foreground="#d1d5db" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- CARTE 4 : RESTAURATION & LANCEMENT -->
                        <Border Grid.Row="2" Grid.Column="2" Background="#111420" CornerRadius="10" Padding="12" BorderBrush="#1c2234" BorderThickness="1">
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="🛡️ RESTAURATION &amp; ACTIONS" FontSize="10" FontWeight="Bold" Foreground="#9ca3af" Margin="0,0,0,6"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="6"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Button Click="BtnRestoreDiscordClean_Click" Grid.Column="0" Height="32" Background="#261b1f" Cursor="Hand">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}" BorderBrush="#42252c" BorderThickness="1" CornerRadius="6">
                                                    <TextBlock Text="Dépatcher Discord" FontSize="10" FontWeight="SemiBold" Foreground="#f87171" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                    <Button Click="BtnLaunchDiscordNow_Click" Grid.Column="2" Height="32" Background="#5865F2" Cursor="Hand">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}" CornerRadius="6">
                                                    <TextBlock Text="🎮 Lancer Discord" FontSize="10.5" FontWeight="Bold" Foreground="#fff" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- 4. Journal / Console de statut -->
                    <Border Grid.Row="3" Background="#090b12" CornerRadius="6" Padding="10,6" BorderBrush="#181c2b" BorderThickness="1">
                        <TextBlock x:Name="LblManagerLog" Text="Prêt. Sélectionnez une action ci-dessus." FontSize="11" Foreground="#9ca3af" TextTrimming="CharacterEllipsis"/>
                    </Border>
                </Grid>

            </Grid>
        </Border>
    </Grid>
</Window>


