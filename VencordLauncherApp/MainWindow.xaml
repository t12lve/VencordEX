<Window x:Class="VencordLauncher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:VencordLauncher"
        mc:Ignorable="d"
        Title="Discord • VencordEX" 
        Height="310" Width="540"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Icon="app.ico"
        ShowInTaskbar="True"
        MouseLeftButtonDown="Window_MouseLeftButtonDown"
        Loaded="Window_Loaded">

    <Window.Resources>
        <!-- Animation de pulsation pour le point vert -->
        <Storyboard x:Key="PulseStoryboard" RepeatBehavior="Forever">
            <DoubleAnimation Storyboard.TargetName="PulseDot"
                             Storyboard.TargetProperty="Opacity"
                             From="1.0" To="0.3" Duration="0:0:1"
                             AutoReverse="True" />
            <DoubleAnimation Storyboard.TargetName="PulseDotScale"
                             Storyboard.TargetProperty="ScaleX"
                             From="1.0" To="1.3" Duration="0:0:1"
                             AutoReverse="True" />
            <DoubleAnimation Storyboard.TargetName="PulseDotScale"
                             Storyboard.TargetProperty="ScaleY"
                             From="1.0" To="1.3" Duration="0:0:1"
                             AutoReverse="True" />
        </Storyboard>
    </Window.Resources>

    <Grid Margin="12">
        <!-- Conteneur principal avec ombre portée et bordure arrondie -->
        <Border x:Name="MainContainerBorder" CornerRadius="22" Background="#101218" BorderBrush="#252936" BorderThickness="1.2">
            <Border.Effect>
                <DropShadowEffect BlurRadius="32" ShadowDepth="0" Color="#5865F2" Opacity="0.35"/>
            </Border.Effect>

            <Grid Margin="24,20,24,20">

                <!-- ═══════════════════════════════════════════════════════ -->
                <!-- ÉCRAN 1 : PRÉCHARGEUR ANIMÉ                          -->
                <!-- ═══════════════════════════════════════════════════════ -->
                <Grid x:Name="PreloaderGrid" Visibility="Visible">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- En-tête : Badge VencordEX + Bouton Paramètres ⚙️ -->
                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Image Source="app.ico" Width="20" Height="20" Margin="0,0,10,0"/>
                            <TextBlock Text="VENCORDEX" FontWeight="ExtraBold" FontSize="13" Foreground="#8da0f9"/>
                            <TextBlock Text=" • AUTO-PATCHER" FontWeight="Bold" FontSize="13" Foreground="#4e5366" Margin="4,0,0,0"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <!-- Indicateur statut pill -->
                            <Border Background="#181c26" CornerRadius="12" Padding="10,4,12,4" BorderBrush="#282f42" BorderThickness="1" Margin="0,0,8,0">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Grid Width="8" Height="8" Margin="0,0,8,0">
                                        <Ellipse x:Name="PulseDot" Fill="#57F287" RenderTransformOrigin="0.5,0.5">
                                            <Ellipse.RenderTransform>
                                                <ScaleTransform x:Name="PulseDotScale" ScaleX="1" ScaleY="1"/>
                                            </Ellipse.RenderTransform>
                                        </Ellipse>
                                    </Grid>
                                    <TextBlock x:Name="BadgeText" Text="INJECTION" FontSize="11" FontWeight="Bold" Foreground="#57F287"/>
                                </StackPanel>
                            </Border>

                            <!-- Bouton accès au Centre de Contrôle -->
                            <Button Click="BtnOpenManager_Click" ToolTip="Ouvrir le Centre de Contrôle"
                                    Width="28" Height="28" Background="#181c26" BorderBrush="#282f42" BorderThickness="1" Cursor="Hand">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8">
                                            <TextBlock Text="⚙" FontSize="13" Foreground="#8da0f9" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </StackPanel>
                    </Grid>

                    <!-- Section Centrale : Compteur -->
                    <Grid Grid.Row="1" VerticalAlignment="Center" Margin="0,15,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock x:Name="StatusTitle" Text="SYNCHRONISATION" FontSize="11" FontWeight="Bold" Foreground="#656d8a" Margin="0,0,0,4"/>
                            <TextBlock x:Name="StatusSub" Text="Vérification des fichiers de Discord..." FontSize="14" FontWeight="SemiBold" Foreground="#f2f3f5" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>

                        <TextBlock x:Name="PercentText" Grid.Column="1" Text="00%" 
                                   FontSize="52" FontWeight="Black" 
                                   FontFamily="Segoe UI Variable Display, Inter, Segoe UI" 
                                   Foreground="#FFFFFF" 
                                   VerticalAlignment="Center" HorizontalAlignment="Right">
                            <TextBlock.Effect>
                                <DropShadowEffect BlurRadius="20" ShadowDepth="0" Color="#5865F2" Opacity="0.4"/>
                            </TextBlock.Effect>
                        </TextBlock>
                    </Grid>

                    <!-- Barre de progression -->
                    <Grid Grid.Row="2" Margin="0,5,0,12">
                        <Border Height="12" Background="#161822" CornerRadius="6" BorderBrush="#202433" BorderThickness="1">
                            <Grid ClipToBounds="True">
                                <Border x:Name="ProgressBarFill" HorizontalAlignment="Left" Width="0" CornerRadius="5">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                            <GradientStop Color="#5865F2" Offset="0.0"/>
                                            <GradientStop Color="#854FEE" Offset="0.4"/>
                                            <GradientStop Color="#EB459E" Offset="0.8"/>
                                            <GradientStop Color="#57F287" Offset="1.0"/>
                                        </LinearGradientBrush>
                                    </Border.Background>
                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="12" ShadowDepth="0" Color="#5865F2" Opacity="0.8"/>
                                    </Border.Effect>
                                </Border>
                            </Grid>
                        </Border>
                    </Grid>

                    <!-- Pied de carte -->
                    <Grid Grid.Row="3">
                        <TextBlock x:Name="FooterText" Text="PRÉPARATION DE DISCORD EN COURS..." 
                                   FontSize="10.5" FontWeight="Bold" Foreground="#4e5366"/>
                        <TextBlock Text="t12lve le vibecodeur de l'extreme" HorizontalAlignment="Right"
                                   FontSize="9" FontWeight="SemiBold" Foreground="#4e5366"/>
                    </Grid>
                </Grid>

                <!-- ═══════════════════════════════════════════════════════ -->
                <!-- ÉCRAN 2 : DIALOGUE DE CONFIRMATION (DISCORD OUVERT)   -->
                <!-- ═══════════════════════════════════════════════════════ -->
                <Grid x:Name="ConfirmGrid" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Image Source="app.ico" Width="20" Height="20" Margin="0,0,10,0"/>
                            <TextBlock Text="MISE À JOUR DÉTECTÉE" FontWeight="ExtraBold" FontSize="12.5" Foreground="#FEE75C"/>
                            <TextBlock Text=" • DISCORD EN COURS" FontWeight="Bold" FontSize="12.5" Foreground="#5d637a" Margin="4,0,0,0"/>
                        </StackPanel>
                    </Grid>

                    <StackPanel Grid.Row="1" VerticalAlignment="Center" Margin="0,10,0,12">
                        <TextBlock Text="Discord est actuellement ouvert" FontSize="20" FontWeight="Bold" Foreground="#FFFFFF" Margin="0,0,0,6"/>
                        <TextBlock Text="Une mise à jour sans Vencord a été détectée. Pour appliquer le patch immédiatement, Discord doit être redémarré."
                                   FontSize="12.5" Foreground="#949ba4" TextWrapping="Wrap" LineHeight="18"/>
                        <TextBlock Text="Voulez-vous fermer Discord maintenant ou préparer le patch pour le prochain lancement ?"
                                   FontSize="12" Foreground="#8da0f9" TextWrapping="Wrap" Margin="0,6,0,0" FontWeight="SemiBold"/>
                    </StackPanel>

                    <Grid Grid.Row="2" Margin="0,5,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Button x:Name="BtnKillAndRestart" Grid.Column="0" Click="BtnKillAndRestart_Click"
                                Height="44" Cursor="Hand" Background="#5865F2">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="10">
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <TextBlock Text="⚡ Oui, redémarrer" FontWeight="Bold" FontSize="13" Foreground="#FFFFFF"/>
                                        </StackPanel>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="border" Property="Background" Value="#4752C4"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>

                        <Button x:Name="BtnPatchNextLaunch" Grid.Column="2" Click="BtnPatchNextLaunch_Click"
                                Height="44" Cursor="Hand" Background="#1a1c26">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="border" Background="{TemplateBinding Background}" BorderBrush="#2f3448" BorderThickness="1.2" CornerRadius="10">
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <TextBlock Text="⏱ Au prochain lancement" FontWeight="SemiBold" FontSize="12.5" Foreground="#B5BAC1"/>
                                        </StackPanel>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="border" Property="Background" Value="#232635"/>
                                            <Setter TargetName="border" Property="BorderBrush" Value="#444b68"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </Grid>
                </Grid>

                <!-- ═══════════════════════════════════════════════════════ -->
                <!-- ÉCRAN 3 : CENTRE DE CONTRÔLE VENCORDEX (GUI COMPLET)  -->
                <!-- ═══════════════════════════════════════════════════════ -->
                <Grid x:Name="ManagerGrid" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- 1. En-tête avec boutons de fenêtre -->
                    <Grid Grid.Row="0" Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Image Source="app.ico" Width="22" Height="22" Margin="0,0,10,0"/>
                            <TextBlock Text="VENCORDEX" FontWeight="Black" FontSize="14" Foreground="#8da0f9"/>
                            <TextBlock Text=" • CENTRE DE CONTRÔLE" FontWeight="Bold" FontSize="14" Foreground="#4e5366" Margin="4,0,0,0"/>
                        </StackPanel>

                        <!-- Bouton fermer -->
                        <Button Click="BtnCloseManager_Click" Grid.Column="1" Width="26" Height="26" Background="#1c1f2b" BorderBrush="#2e3347" BorderThickness="1" Cursor="Hand">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6">
                                        <TextBlock Text="✕" FontSize="12" Foreground="#949ba4" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </Grid>

                    <!-- 2. Badges de Statut en Direct -->
                    <Border Grid.Row="1" Background="#141720" CornerRadius="12" Padding="14,10" BorderBrush="#222736" BorderThickness="1" Margin="0,0,0,14">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="VERSION DISCORD" FontSize="9.5" FontWeight="Bold" Foreground="#656d8a"/>
                                <TextBlock x:Name="LblDiscordVersion" Text="1.0.9255" FontSize="12" FontWeight="Bold" Foreground="#FFFFFF" Margin="0,2,0,0"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1">
                                <TextBlock Text="PATCH VENCORD" FontSize="9.5" FontWeight="Bold" Foreground="#656d8a"/>
                                <TextBlock x:Name="LblVencordStatus" Text="✓ ACTIF" FontSize="12" FontWeight="Bold" Foreground="#57F287" Margin="0,2,0,0"/>
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="OPENASAR" FontSize="9.5" FontWeight="Bold" Foreground="#656d8a"/>
                                <TextBlock x:Name="LblOpenAsarStatus" Text="NON INSTALLÉ" FontSize="12" FontWeight="Bold" Foreground="#949ba4" Margin="0,2,0,0"/>
                            </StackPanel>

                            <StackPanel Grid.Column="3">
                                <TextBlock Text="RACCOURCI MENU" FontSize="9.5" FontWeight="Bold" Foreground="#656d8a"/>
                                <TextBlock x:Name="LblShortcutStatus" Text="✓ VENCORDEX" FontSize="12" FontWeight="Bold" Foreground="#57F287" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- 3. Cartes d'Actions (Grille 2x2) -->
                    <Grid Grid.Row="2" Margin="0,0,0,12">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="8"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- CARTE 1 : RACCOURCIS WINDOWS -->
                        <Border Grid.Row="0" Grid.Column="0" Background="#141722" CornerRadius="12" Padding="14" BorderBrush="#202535" BorderThickness="1">
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="🔗 RACCOURCIS WINDOWS" FontSize="10.5" FontWeight="ExtraBold" Foreground="#8da0f9" Margin="0,0,0,8"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="6"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Button Click="BtnPatchShortcut_Click" Grid.Column="0" Height="34" Background="#5865F2" Cursor="Hand">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}" CornerRadius="6">
                                                    <TextBlock Text="Patcher raccourci" FontSize="11" FontWeight="Bold" Foreground="#fff" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                    <Button Click="BtnUnpatchShortcut_Click" Grid.Column="2" Height="34" Background="#1e2230" Cursor="Hand">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}" BorderBrush="#2c3247" BorderThickness="1" CornerRadius="6">
                                                    <TextBlock Text="Restaurer original" FontSize="11" FontWeight="SemiBold" Foreground="#b5bac1" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- CARTE 2 : OPENASAR & PATCHES -->
                        <Border Grid.Row="0" Grid.Column="2" Background="#141722" CornerRadius="12" Padding="14" BorderBrush="#202535" BorderThickness="1">
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="⚡ OPENASAR (OPTIMISATION)" FontSize="10.5" FontWeight="ExtraBold" Foreground="#eb459e" Margin="0,0,0,8"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="6"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Button Click="BtnInstallOpenAsar_Click" Grid.Column="0" Height="34" Background="#eb459e" Cursor="Hand">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}" CornerRadius="6">
                                                    <TextBlock Text="Installer OpenAsar" FontSize="11" FontWeight="Bold" Foreground="#fff" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                    <Button Click="BtnUninstallOpenAsar_Click" Grid.Column="2" Height="34" Background="#1e2230" Cursor="Hand">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}" BorderBrush="#2c3247" BorderThickness="1" CornerRadius="6">
                                                    <TextBlock Text="Retirer OpenAsar" FontSize="11" FontWeight="SemiBold" Foreground="#b5bac1" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- CARTE 3 : SAUVEGARDE DES PRÉFÉRENCES -->
                        <Border Grid.Row="2" Grid.Column="0" Background="#141722" CornerRadius="12" Padding="14" BorderBrush="#202535" BorderThickness="1">
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="💾 PRÉFÉRENCES &amp; THÈMES VENCORD" FontSize="10.5" FontWeight="ExtraBold" Foreground="#57F287" Margin="0,0,0,8"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="6"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Button Click="BtnBackupPreferences_Click" Grid.Column="0" Height="34" Background="#238636" Cursor="Hand">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}" CornerRadius="6">
                                                    <TextBlock Text="💾 Exporter Backup" FontSize="11" FontWeight="Bold" Foreground="#fff" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                    <Button Click="BtnRestorePreferences_Click" Grid.Column="2" Height="34" Background="#1e2230" Cursor="Hand">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}" BorderBrush="#2c3247" BorderThickness="1" CornerRadius="6">
                                                    <TextBlock Text="📥 Importer Backup" FontSize="11" FontWeight="SemiBold" Foreground="#b5bac1" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- CARTE 4 : RESTAURER DISCORD & LANCER -->
                        <Border Grid.Row="2" Grid.Column="2" Background="#141722" CornerRadius="12" Padding="14" BorderBrush="#202535" BorderThickness="1">
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="🛡️ RESTAURATION &amp; LANCEMENT" FontSize="10.5" FontWeight="ExtraBold" Foreground="#fee75c" Margin="0,0,0,8"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="6"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Button Click="BtnRestoreDiscordClean_Click" Grid.Column="0" Height="34" Background="#2c1f24" BorderBrush="#522432" BorderThickness="1" Cursor="Hand">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6">
                                                    <TextBlock Text="Retirer tous patchs" FontSize="11" FontWeight="Bold" Foreground="#f38ba8" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                    <Button Click="BtnLaunchDiscordNow_Click" Grid.Column="2" Height="34" Background="#5865F2" Cursor="Hand">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}" CornerRadius="6">
                                                    <TextBlock Text="🎮 Lancer Discord" FontSize="11" FontWeight="Bold" Foreground="#fff" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- 4. Barre de Log / Notification d'action en bas -->
                    <Border Grid.Row="3" Background="#0b0d12" CornerRadius="8" Padding="12,8" BorderBrush="#1c202c" BorderThickness="1">
                        <Grid>
                            <TextBlock x:Name="LblManagerLog" Text="Prêt. Sélectionnez une action ci-dessus." FontSize="11.5" Foreground="#8da0f9" TextTrimming="CharacterEllipsis"/>
                            <Button Click="BtnOpenBackupsFolder_Click" HorizontalAlignment="Right" Background="Transparent" BorderThickness="0" Cursor="Hand">
                                <TextBlock Text="📁 Ouvrir dossier Backups" FontSize="11" Foreground="#656d8a" TextDecorations="Underline"/>
                            </Button>
                        </Grid>
                    </Border>
                </Grid>

            </Grid>
        </Border>
    </Grid>
</Window>
